# PRODUCTION ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# Copy to .env for deployment

# --- DATABASE CONFIGURATION ---
MYSQL_DATABASE=proposal_governance
MYSQL_USER=governance_user
MYSQL_PASSWORD=ProductionPassword123!
MYSQL_ROOT_PASSWORD=RootProductionPassword123!
DATABASE_CONNECTION_STRING=Server=mysql-db;Port=3306;Database=proposal_governance;User Id=governance_user;Password=ProductionPassword123!;

# --- SECURITY & JWT ---
JWT_KEY=SuperSecretProductionJWTKeyMinimum256BitsLong123456789!
JWT_ISSUER=ProposalGovernanceApi
JWT_AUDIENCE=ProposalGovernanceClient

# --- EXTERNAL INTEGRATIONS ---
GEMINI_API_KEY=your_gemini_api_key_here
RAZORPAY_KEY=your_razorpay_key_id_here
RAZORPAY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- FILE STORAGE ---
STORAGE_PROVIDER=Local # Options: Local | S3
S3_BUCKET_NAME=innovaura-proposal-documents-prod
S3_REGION=us-east-1

# --- CORS & APP CONFIG ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://innovaura.com
ENABLE_SWAGGER=true
